APP_ENV=development
APP_NAME=ProcurePilot AI
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/procurepilot
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini / ADK (backend only)
GOOGLE_API_KEY=
AI_MODEL=gemini-3.8-flash
# Bounded single-call ADK analysis and UTC daily spend protection
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_SECONDS=35
AI_DAILY_USER_RUNS=12
AI_DAILY_GLOBAL_RUNS=100
AI_EVIDENCE_CANDIDATES=4

# Channel3 Product API (backend only)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# PayPal Orders v2 Sandbox (backend only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Do not put secrets in VITE_ variables. This is a public browser URL only.
VITE_API_BASE_URL=http://localhost:8000/api/v1
