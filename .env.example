APP_ENV=development
APP_NAME=ProcurePilot AI
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/procurepilot
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Required for auth in staging/production. Managed Redis over TLS.
# Local development intentionally runs without Redis.
RATE_LIMIT_REDIS_URL=
# Conservatively cap PostgreSQL connections PER WORKER/INSTANCE.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=15000
MAX_REQUEST_BODY_BYTES=1048576

# Primary Google ADK Gemini (backend only). Windows process variables override .env.
GOOGLE_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Optional Google ADK LiteLLM fallback. Add keys to enable; no key = no route.
# Groq first, OpenRouter second. Both consume provider quotas when used.
AI_FALLBACK_ENABLED=true
GROQ_API_KEY=
AI_GROQ_MODEL=groq/openai/gpt-oss-20b
OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=openrouter/google/gemma-4-26b-a4b-it:free
# Bounded provider attempts: primary Gemini + at most two opted-in backups.
# The total wall-clock deadline and daily quotas apply across attempts.
# AI analysis and UTC daily spend protection
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_SECONDS=60
AI_DAILY_USER_RUNS=12
AI_DAILY_GLOBAL_RUNS=100
AI_EVIDENCE_CANDIDATES=4
# Maximum characters of the bounded AI packet (not a count of billed tokens).
AI_MAX_PROMPT_CHARS=3600

# Channel3 Product API (backend only)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# PayPal Orders v2 Sandbox (backend only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Do not put secrets in VITE_ variables. This is a public browser URL only.
VITE_API_BASE_URL=http://localhost:8000/api/v1
