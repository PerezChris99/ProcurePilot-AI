{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ProcurePilot: Frontend Production Build",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ProcurePilot: Backend (Integrated Terminal)",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "procurepilot-backend",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Uvicorn running on http://127\\.0\\.0\\.1:8000.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "procurepilot",
        "clear": true
      }
    },
    {
      "label": "ProcurePilot: Frontend Dev Server (Integrated Terminal)",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "args": [
        "--",
        "--host",
        "127.0.0.1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "procurepilot-frontend",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://127\\.0\\.0\\.1:5173.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "procurepilot",
        "clear": true
      }
    },
    {
      "label": "ProcurePilot: Build then Start (VS Code Terminals)",
      "dependsOn": [
        "ProcurePilot: Frontend Production Build",
        "ProcurePilot: Backend (Integrated Terminal)",
        "ProcurePilot: Frontend Dev Server (Integrated Terminal)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
